    LIBROS   ||--o{ PRESTAMOS : contiene

    USUARIOS {
        int id_usuario PK
        varchar nombre
        varchar correo UK
        varchar telefono
        date fecha_registro
        boolean activo
    }

    LIBROS {
        int id_libro PK
        varchar titulo
